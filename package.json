{
  "name": "aether",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.mjs",
    "preview": "python3 -m http.server 4173 --bind 127.0.0.1 --directory out"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "idb": "^8.0.4",
